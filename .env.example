# ==============================================================================
# SovereignClaw OS - Environment Configuration
# NVIDIA x Nebius Global AI Hackathon (Personal AI Track)
# ==============================================================================

# Nebius Token Factory API Key (Leave empty to use high-fidelity offline simulation mode)
NEBIUS_API_KEY=

# Nebius Token Factory Base URL
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.ai/v1

# Preferred Default Model Tier
# Options: nemotron-3-ultra | nemotron-super | nemotron-nano | llama-3.1-nemotron-70b
DEFAULT_MODEL_TIER=nemotron-3-ultra

# Model Names on Nebius Token Factory
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL_SUPER=nebius/nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_NANO=nebius/nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL_LLAMA_NEMOTRON=nvidia/llama-3.1-nemotron-70b-instruct

# NVIDIA OpenShell Sandbox Bounds
OPENSHELL_SANDBOX_TIMEOUT_MS=8000
OPENSHELL_MEMORY_LIMIT_MB=512
OPENSHELL_STRICT_EGRESS_BLOCK=true

# NVIDIA NemoClaw Guardrails Configuration
NEMOCLAW_INJECTION_THRESHOLD=0.40
NEMOCLAW_LOCAL_ENCLAVE_ACTIVE=true
