# Explicit local demo: no model is called. Use live for the hackathon submission.
INFERENCE_MODE=demo
# Set these securely in hosting/environment settings, never in Git.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# This NVIDIA model was verified with a real Nebius inference request.
# Confirm availability in your account with npm run doctor:nebius.
# A nonempty key with no valid model configuration fails explicitly.
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional per-tier model IDs (NEBIUS_MODEL overrides all tiers).
NEBIUS_MODEL_ULTRA=
NEBIUS_MODEL_SUPER=
NEBIUS_MODEL_NANO=
NEBIUS_MODEL_LLAMA_NEMOTRON=
# Production requires an owner password; browser login username is owner.
ASSISTANT_PASSWORD=
# On hosting, point to a durable private volume. Do not put data in public/.
SOVEREIGN_DATA_DIR=.sovereign-data
ASSISTANT_URL=http://127.0.0.1:3000
ASSISTANT_TIMEZONE=Asia/Kolkata
